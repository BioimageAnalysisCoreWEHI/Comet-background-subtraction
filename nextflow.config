/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BioimageAnalysisCoreWEHI/Comet-background-subtraction Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params
params {

    // Input/output options (provide exactly one of input / input_dir)
    input                        = null   // samplesheet CSV: sample_id,image_path[,remove]
    input_dir                    = null   // directory of *.tif / *.tiff / *.ome.tif
    outdir                       = null
    publish_dir_mode             = 'copy'

    // Marker-detection options (comet_markers.py)
    registration_filter          = 'DAPI' // FluorescenceChannel/band used for registration (never subtracted)
    keep_background              = false  // keep AF / negative-control channels in the output
    remove_extra_dapi            = false  // drop every registration (DAPI) channel except the first
    use_nearest_background       = false  // nearest preceding same-band background of ANY kind (canonical backsub); default = Horizon "auto" mode (same-band _AF reference)

    // Background-subtraction options (backsub)
    save_ram                     = true   // -sr : ~50% less RAM (recommended for large COMET images)
    compression                  = 'zlib' // -comp : lzw|zlib|deflate|none (zlib compresses 16-bit data better; QuPath reads it fine)
    tile_size                    = 256    // -ts  : pyramid tile size, multiple of 16
    downscale_factor             = 2      // -dsf : pyramid downscale (only used if input is not pyramidal)
    pixel_size                   = null   // -mpp : microns/pixel; taken from metadata if null

    // Boilerplate
    monochrome_logs              = false
    help                         = false
    version                      = false
    validate_params              = true
}

// Sensible defaults so the pipeline runs locally without a resource profile
process {
    executor      = 'local'
    cpus          = 2
    memory        = 16.GB
    time          = 4.h
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_low' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // Modest, local-friendly base defaults; the SLURM resource profiles
    // (small/medium/large) set the real CPU/memory footprint.
    withLabel: 'process_backsub' {
        cpus   = 2
        memory = { 32.GB * task.attempt }
        time   = { 24.h }
    }
}

docker.enabled     = false
singularity.enabled = false
conda.enabled      = false

profiles {
    debug {
        dumpHashes           = true
        process.beforeScript = 'echo $HOSTNAME'
        cleanup              = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
        podman.enabled      = false
        apptainer.enabled   = false
    }
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        docker.enabled      = false
        singularity.enabled = false
        podman.enabled      = false
        apptainer.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
    }

    // ---- Resource profiles (SLURM). backsub is memory-bound on large COMET slides. ----

    // Smaller slides / test runs — targets sml/med nodes.
    small {
        process {
            executor = 'slurm'
            queue    = 'regular'
            withLabel: 'process_low' {
                cpus   = { 2 }
                memory = { 16.GB * task.attempt }
                time   = { 1.h }
            }
            withLabel: 'process_backsub' {
                cpus   = { 4 }
                memory = { 128.GB * task.attempt }
                time   = { 24.h }
            }
        }
        executor {
            queueSize       = 20
            submitRateLimit = '10 sec'
        }
    }

    // Medium slides (~500 GB RAM) — targets med/il nodes.
    medium {
        process {
            executor = 'slurm'
            queue    = 'regular'
            withLabel: 'process_low' {
                cpus   = { 2 }
                memory = { 16.GB * task.attempt }
                time   = { 1.h }
            }
            withLabel: 'process_backsub' {
                cpus   = { 8 }
                memory = { 480.GB * task.attempt }
                time   = { 36.h }
            }
        }
        executor {
            queueSize       = 20
            submitRateLimit = '10 sec'
        }
    }

    // Large slides (~1 TB RAM) — targets lrg nodes. Default for full-size COMET exports (100s of GB).
    large {
        process {
            executor = 'slurm'
            queue    = 'regular'
            withLabel: 'process_low' {
                cpus   = { 2 }
                memory = { 16.GB * task.attempt }
                time   = { 1.h }
            }
            withLabel: 'process_backsub' {
                cpus   = { 16 }
                memory = { 960.GB * task.attempt }
                time   = { 48.h }
            }
        }
        executor {
            queueSize       = 10
            submitRateLimit = '10 sec'
        }
    }
}

// Export these variables to prevent local Python libraries conflicting with the conda env
env {
    PYTHONNOUSERSITE = 1
    TMPDIR           = "/vast/scratch/users/\$USER/temp"
}

// Bash strict-mode options for all process scripts
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

nextflow.enable.configProcessNamesValidation = false

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

manifest {
    name            = 'BioimageAnalysisCoreWEHI/Comet-background-subtraction'
    author          = """WEHI Bioimaging Analysis Core"""
    homePage        = 'https://github.com/BioimageAnalysisCoreWEHI/Comet-background-subtraction'
    description     = """Headless background subtraction of Lunaphore COMET OME-TIFFs (Horizon auto mode) for QuPath"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.2'
    version         = '0.1.0'
}
